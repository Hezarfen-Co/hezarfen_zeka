# hezarfen-ZEKA — ortam degiskenleri.
#
#   cp .env.example .env    ve doldur
#   podman compose --env-file .env up -d
#
# `.env` GITIGNORE'LUDUR ve depoya girmez. Bu dosya sablondur; gercek deger
# TASIMAZ.

# ============================================================================
# ZORUNLU — ikisi de bos birakilirsa servis ACILISTA reddeder
# ============================================================================

# Backend ile AYNI sir. Kopru kaydi bununla yapilir; backend'in
# AI_SHARED_TOKEN degeriyle birebir ayni olmali.
AI_SHARED_TOKEN=

# Segment hattinin LLM anahtari. Kopru bu anahtari OKUMAZ; yalnizca
# `src/segment/` okur. Yine de zorunlu tutuluyor: anahtarsiz bir servis ayaga
# kalkar, segment hatti kosuldugunda patlardi. Hatayi dagitim anina cekiyoruz.
#
# ADLAR (2026-09-17 temiz kesim -- eski adlar DESTEKLENMEZ, gorulurlerse
# yapilandirma acilista REDDEDILIR):
#     LLM_API_KEY                     anahtar (zorunlu)
#     LLM_BASE_URL                    taban adres (varsayilan https://api.deepseek.com)
#     LLM_MODEL_FLASH / LLM_MODEL_PRO / LLM_MODEL_REASONER   rol basina model
#     LLM_MODEL_ROLE                  varsayilan rol secimi
# Kaldirilan adlar: DEEPSEEK_API_KEY, SEGMENT_API_KEY, SEGMENT_BASE_URL,
# SEGMENT_MODEL_FLASH/PRO/REASONER, SEGMENT_MODEL_ROLE.
#
# SAGLAYICI: DeepSeek varsayilandir, ZORUNLULUK DEGILDIR. OpenAI uyumlu her
# ag gecidi calisir: LLM_BASE_URL'i gecidinize verin ve model kimliklerini
# LLM_MODEL_* ile o saglayicinin adlariyla degistirin. Bos birakmak
# "varsayilani kullan" demektir.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FLASH=
LLM_MODEL_PRO=
LLM_MODEL_REASONER=
LLM_MODEL_ROLE=

# ============================================================================
# KOPRU
# ============================================================================

AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090
AI_BACKEND_URL=http://hezarfen_backend:7656
AI_TLS_SERVER_NAME=localhost
AI_SERVICE_NAME=zeka

# Backend'in acilista logladigi SHA-256 parmak izi (64 hex, iki nokta yok).
# BOS BIRAKILIRSA TOFU: backend'in HTTP ile verdigi sertifikaya sorgusuz
# guvenilir. Podcast ve Celebi'nin bugunku hali ve denetimde zafiyet olarak
# isaretlendi. URETIMDE DOLDURUN.
AI_TLS_FINGERPRINT=

AI_MAX_CONCURRENT=4
AI_RECONNECT_SECS=3
AI_RECONNECT_MAX_SECS=120

# ============================================================================
# KAPSAM
# ============================================================================
#
# Okul KUTUGU backend'dedir: hangi okullarin var oldugu `insight.schools.list`
# yetenek cagrisiyla backend'den okunur. ZEKA_SCHOOLS yalnizca bir FILTREdir;
# BOS BIRAKILIRSA butun aktif okullar islenir. Ornek filtre: hezarfen-demo
ZEKA_SCHOOLS=

# Ogrenci listesi hala buradan verilir: backend'de kullanici LISTELEME yolu
# yok (izin listesi `constant.rs:641-661`).
# Bkz. service/docs/BACKEND-GEREKSINIMLERI.md madde 3.
ZEKA_STUDENT_SOURCE=config
ZEKA_STUDENTS=
ZEKA_STUDENT_FILE=

# ============================================================================
# VERI CEPHESI
# ============================================================================
# bridge = veri backend'den `insight.*` cagrilariyla gelir (uretim yolu).
# Fixture koku compose'da sabittir (/data/zeka/fixtures), buradan verilmez.
ZEKA_SOURCE=bridge
ZEKA_API_TIMEOUT_SECS=15
ZEKA_BLOB_TIMEOUT_SECS=60

# ============================================================================
# ZAMANLAMA
# ============================================================================
# 0 = periyodik kosu kapali, yalnizca istek uzerine.
ZEKA_REFRESH_INTERVAL_SECS=3600
ZEKA_REFRESH_JITTER_SECS=60
ZEKA_REFRESH_BATCH=25

# ============================================================================
# AG
# ============================================================================
# Backend'in compose agi. Dagitimdan dagitima degisebilir.
HEZARFEN_NET=hezarfen_backend_default

LOG_LEVEL=info
