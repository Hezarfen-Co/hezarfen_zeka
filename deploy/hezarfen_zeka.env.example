# hezarfen_zeka.env -- ZEKA koprusunun SUNUCU ayarlari.
#
# Sunucuda TEK SEFERLIK, elle:
#   mkdir -p ~/hezarfen_zeka
#   cp deploy/hezarfen_zeka.env.example ~/hezarfen_zeka/hezarfen_zeka.env
#   <degerleri doldur>
#   chmod 0600 ~/hezarfen_zeka/hezarfen_zeka.env
#
# Hicbir otomasyon bu dosyayi OLUSTURMAZ, EZMEZ, YUKLEMEZ -- operatorun malidir;
# deploy yalnizca varligini kontrol eder ve iznini 0600'e ceker. Satirlar duz
# KEY=value: tirnak yok, `export` yok, satir sonu yorumu yok. Yerel gelistirme
# icin esdegeri `service/.env.example`'dir.
#
# KONTEYNERE NASIL ULASIR -- tek kanal, iki tasiyici:
#   * systemd: unit'in `EnvironmentFile=%h/hezarfen_zeka/hezarfen_zeka.env`
#     satiri bu dosyayi unit'in ORTAMINA alir; konteyner ortami oradan miras
#     alir.
#   * deploy: ayni dosyayi satir satir okuyup surece alir (kabuk genisletmesi
#     YOK: deger icindeki `$` oldugu gibi kalir).
#   compose'a giden `--env-file` TEKTIR ve o dosya deploy sahipli `stack.env`
#   olup yalniz `HEZARFEN_TAG` tasir. podman-compose 1.6.0 `--env-file`
#   argumaninin yalniz SON degerini cozer (podman_compose.py:2941-2946,
#   :2559); iki dosyali cagri bu dosyayi tamamen dusurur.
#
# Degerler konteyner BASLARKEN okunur: degisiklikten sonra yeniden olustur
#   systemctl --user restart hezarfen_zeka_compose
#
# Iki sir ZORUNLUDUR (`${VAR:?}`): bos birakilirsa `compose up` DAHA BASLAMADAN
# durur -- anahtarsiz bir kopru ayaga kalkip "calisiyor" gorunurdu ve hata
# gunler sonra ortaya cikardi.

# ============================================================================
# ZORUNLU
# ============================================================================

# Backend ile AYNI sir. Kopru kaydi bununla yapilir; hezarfen_backend.env
# icindeki AI_SHARED_TOKEN ile BIREBIR ayni olmali (iki tarafi birlikte
# degistirin; yalniz birini degistirmek kaydi `unauthorized` ile dusurur ve
# kopru bekler).
AI_SHARED_TOKEN=

# Segment hattinin LLM anahtari. Kopru bu anahtari OKUMAZ; yalnizca
# `src/segment/` okur. Yine de zorunlu tutuluyor: anahtarsiz bir servis ayaga
# kalkar, segment hatti kosuldugunda patlardi. Hatayi dagitim anina cekiyoruz.
#
# ADLAR (2026-09-17 temiz kesim -- eski adlar DESTEKLENMEZ, gorulurlerse
# yapilandirma acilista REDDEDILIR):
#     LLM_API_KEY                     anahtar (zorunlu)
#     LLM_BASE_URL                    taban adres (varsayilan https://api.deepseek.com)
#     LLM_MODEL_FLASH / LLM_MODEL_PRO / LLM_MODEL_REASONER   rol basina model
#     LLM_MODEL_ROLE                  varsayilan rol secimi
# Kaldirilan adlar: DEEPSEEK_API_KEY, SEGMENT_API_KEY, SEGMENT_BASE_URL,
# SEGMENT_MODEL_FLASH/PRO/REASONER, SEGMENT_MODEL_ROLE.
#
# SAGLAYICI: DeepSeek varsayilandir, ZORUNLULUK DEGILDIR. OpenAI uyumlu her
# ag gecidi calisir: LLM_BASE_URL'i gecidinize verin ve model kimliklerini
# LLM_MODEL_* ile o saglayicinin adlariyla degistirin. Bos birakmak
# "varsayilani kullan" demektir.
LLM_API_KEY=
# (Yalnizca kopruyu kosturan bir dagitimda bilincli olarak sahte bir deger
# verilebilir; segment o zaman hata verir, kopru calisir.)
LLM_BASE_URL=
LLM_MODEL_FLASH=
LLM_MODEL_PRO=
LLM_MODEL_REASONER=
LLM_MODEL_ROLE=

# ============================================================================
# KOPRU
# ============================================================================

# Backend'in QUIC dinleyicisi (konteyner aginda). Backend tarafinda
# AI_QUIC_ADDR=0.0.0.0:8090 OLMALI -- 127.0.0.1 yaziliysa backend yalniz kendi
# konteyner loopback'ine baglanir ve HICBIR servis dial-in edemez.
AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090

# Sertifikanin cekildigi HTTP koku. Varsayilan backend konteynerinin kendi
# adresi; backend'in yayimlanan host portu ise 127.0.0.1:7656'dir.
AI_BACKEND_URL=http://hezarfen_backend:7656
AI_TLS_SERVER_NAME=localhost
AI_SERVICE_NAME=zeka

# Sertifika parmak izi pinlemesi -- BACKEND SERTIFIKASI DUZ HTTP ILE CEKILDIGI
# icin tek basina pinlemek yetmez: araya giren biri kendi sertifikasini
# pinletebilir. BOS BIRAKILIRSA TOFU (her acilista uyari olarak loglanir;
# sessiz bir varsayilan degildir). Uretimde doldurun -- 64 hex karakter, iki
# nokta ayraclari atilir. Sunucuda:
#   curl -s http://127.0.0.1:7656/ai/certificate | python -c 'import json,sys; print(json.load(sys.stdin)["fingerprint_sha256"])'
AI_TLS_FINGERPRINT=

AI_MAX_CONCURRENT=4
AI_RECONNECT_SECS=3
AI_RECONNECT_MAX_SECS=120

# ============================================================================
# KAPSAM
# ============================================================================
#
# Okul KUTUGU backend'dedir: hangi okullarin var oldugu `insight.schools.list`
# yetenek cagrisiyla backend'den okunur. ZEKA_SCHOOLS yalnizca bir FILTREdir;
# BOS BIRAKILIRSA butun aktif okullar islenir -- donem ortasi kayit olan
# ogrenci gorunmez, ayrilan silinmez. Ornek filtre: hezarfen-demo
ZEKA_SCHOOLS=

# Ogrenci listesi hala BURADAN verilir: backend'de kullanici LISTELEME yolu
# yok (izin listesi `constant.rs:641-661`).
# Bkz. service/docs/BACKEND-GEREKSINIMLERI.md madde 3.
ZEKA_STUDENT_SOURCE=config
ZEKA_STUDENTS=
ZEKA_STUDENT_FILE=

# ============================================================================
# VERI CEPHESI
# ============================================================================
# bridge = veri backend'den `insight.*` cagrilariyla gelir (uretim yolu).
# Fixture koku compose'da sabittir (/data/zeka/fixtures), buradan verilmez.
ZEKA_SOURCE=bridge
ZEKA_API_TIMEOUT_SECS=15
ZEKA_BLOB_TIMEOUT_SECS=60

# ============================================================================
# ZAMANLAMA
# ============================================================================
# 0 = periyodik kosu kapali, yalnizca istek uzerine.
ZEKA_REFRESH_INTERVAL_SECS=3600
ZEKA_REFRESH_JITTER_SECS=60
ZEKA_REFRESH_BATCH=25

# ============================================================================
# AG / LOG
# ============================================================================
# Backend'in compose agi. Dagitimdan dagitima degisebilir (parametrik).
HEZARFEN_NET=hezarfen_backend_default

# debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# SURUM ETIKETI
# ============================================================================
# BURADAN OKUNMAZ: HEZARFEN_TAG yalnizca compose interpolasyonudur ve deploy'un
# sahip oldugu stack.env icinde tasinir. Elle kostururken varsayilan
# `current`'tir; imaj sunucuda VAR olmali:
#   podman compose up -d --build     # burada derle
#   podman load -i hezarfen_zeka.tar.gz
#HEZARFEN_TAG=current
