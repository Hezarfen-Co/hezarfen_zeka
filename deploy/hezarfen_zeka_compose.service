# systemd KULLANICI unit'i: ZEKA koprusunu podman compose ile calistirir.
# %h/hezarfen_zeka icinde beklenen dosyalar:
#   compose.yaml                bu repodan (deploy artefaktindan gelir)
#   hezarfen_zeka.env           0600, deploy/hezarfen_zeka.env.example'dan
#                               ELLE yazilir -- otomasyon olusturmaz/ezmez
#   stack.env                   deploy sahipli; HEZARFEN_TAG tasir
#
# Unit `--no-build` ile baslar, yani imaj sunucuda zaten olmali:
#   podman compose build            # burada derle
#   podman load -i image.tar        # ya da hazir imaji yukle (deploy bunu yapar)
#
# KAPASITE: ZEKA hafiftir -- olculen imaj 152 MB (docs/DAGITIM.md), model
# dosyasi yok, calisma zamani tek bir Python sureci (kopru). Dagitim yine de
# yer oldugunu olcer (main.yml "KAPASITE ON KONTROLU": >= 512 MB RAM,
# >= 2 GB disk) ve yetmezse nedeniyle birlikte reddeder.
#
# ORTAM IKI KANALDAN GELIR -- bu bir tercih degil, saglayicinin siniridir:
#   * operatorun ayar dosyasi -> `EnvironmentFile=` (systemd dosyayi unit'in
#     ORTAMINA koyar; compose interpolasyonu ORTAM DEGISKENLERINE bakar)
#   * deploy sahipli stack.env (HEZARFEN_TAG) -> tek `--env-file`
#
# NEDEN: `podman compose --env-file A --env-file B` bu saglayicida A'yi HIC
# OKUMAZ. `--env-file` tek degerli bir argumandir (podman_compose.py:2941-2946)
# ve yalniz SON dosya cozulur (:2559 `dotenv_path = os.path.realpath(args.env_file)`).
# Iki dosyali eski cagri operator dosyasini tamamen dusuruyordu; compose.yaml'da
# uc sir `${VAR:?}` oldugu icin `up` DAHA BASLAMADAN "required variable ... is
# missing a value" ile reddediliyordu (canlida yasandi, 2026-09-17). Docker
# Compose v2'nin "sonraki dosya cakisan anahtarda kazanir" davranisi bu
# saglayici icin GECERLI DEGIL. Ortam degiskeni --env-file degerlerini EZER
# (:2562), yani iki kanal cakismaz: operator sirlari ortamdan, HEZARFEN_TAG
# dosyadan gelir.
#
# Dis ag (`hezarfen_backend_default`) backend compose'u tarafindan kurulur;
# yoksa once olusturun: podman network create hezarfen_backend_default
#
# Sadece ortam degiskeni degistiginde yeniden baslatma (ExecStart'i yeniden
# kosar, ortami degisen konteynerı yeniden olusturur):
#   systemctl --user restart hezarfen_zeka_compose

[Unit]
Description=Hezarfen ZEKA bridge (student analysis + recommendations over the school database)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/hezarfen_zeka
# Operatorun ayar dosyasi unit'in ORTAMINA girer (0600; satirlar duz
# KEY=value, systemd kabuk genisletmesi YAPMAZ). Dosya yoksa unit baslamaz --
# compose.yaml'in `${VAR:?}` kapisi zaten orada durur, sessiz bir varsayilana
# dusmez.
EnvironmentFile=%h/hezarfen_zeka/hezarfen_zeka.env
# Tek --env-file: yalniz deploy sahipli stack.env (HEZARFEN_TAG).
ExecStart=/usr/bin/podman compose --env-file %h/hezarfen_zeka/stack.env up -d --no-build
# ExecStop de tek dosya: `${VAR:?}` degiskenleri EnvironmentFile'dan gelir,
# HEZARFEN_TAG'in varsayilani var (`:-current`), stack.env yoksa da `down`
# calisir -- saglayici eksik env dosyasini bos sozluk sayar
# (podman_compose.py:2247-2250).
# `-v` yok: zeka-fixtures isimli volume stop'ta yasamali.
ExecStop=/usr/bin/podman compose --env-file %h/hezarfen_zeka/stack.env down
TimeoutStartSec=180

[Install]
WantedBy=default.target
